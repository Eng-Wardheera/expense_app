
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "run.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "run.py"
    }
  ],
  "crons": [
    {
      "path": "/plan/notifications/cron",
      "schedule": "*/5 * * * *"
    }
  ]
}
